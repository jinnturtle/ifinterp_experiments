@startuml

skinparam backgroundColor #c0c0c0

class Thing {
        string name
        string description
        attrib[] attributes
}

class Container {
        map<string, thing> contents
}

class Room {
        bool visited
        exit[] exits
}

Thing <|-- Container
Thing *-- Container
Container <|-- Room
Room *-- Exit

class World {
        map<string, Room*> rooms

}

World *-- Room

class Exit {
        WIP
}


@enduml
